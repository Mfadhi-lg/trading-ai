          "$ref": "#/$defs/field"
        }
      }
    },
    "evidence_review_queue": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "evidence_decision": {
                "enum": [
                  "NEEDS_REVIEW",
                  "WITHHELD"
                ]
              }
            }
          }
        ]
      }
    },
    "source_coverage": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "required": [
        "network",
        "database_connections",
        "inference_calls",
        "modes"
      ],
      "properties": {
        "network": {
          "const": "denied"
        },
        "database_connections": {
          "const": "denied"
        },
        "inference_calls": {
          "const": 0
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "deterministic_extraction",
              "replayed_ai", "generated_ai"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "claim_ids",
        "review_claim_ids",
        "completeness",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "DISCLOSED",
            "NOT_DISCLOSED",
            "UNRESOLVED"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "review_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "completeness": {
          "enum": [
            "PARTIAL",
            "UNRESOLVED"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "fields",
        "statement",
        "value",
        "unit",
        "period",
        "accounting_scope",
        "attribution",
        "qualifications",
        "statement_kind",
        "evidence_decision",
        "phase5_status",
        "evidence",
        "validation",
        "origin"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "enum": [
              "rating.facility",
              "rating.tenor",
              "rating.current_rating",
              "rating.previous_rating",
              "rating.action",
              "rating.outlook",
              "rating.facility_amount",
              "rating.watch",
              "rating.withdrawal",
              "rating.action_date",
              "liquidity.assessment",
              "liquidity.cash_and_liquid_balances",
              "liquidity.bank_limit_utilisation",
              "liquidity.repayment_obligations",
              "liquidity.cash_accruals",
              "liquidity.explanations_and_constraints",
              "assessment.accounting_approach",
              "assessment.revenue_and_profitability",
              "assessment.revenue_explanations",
              "assessment.profitability_explanations",
              "assessment.debt_and_leverage",
              "assessment.interest_coverage_and_debt_protection",
              "assessment.working_capital_intensity",
              "assessment.operational_strengths",
              "assessment.business_weaknesses",
              "assessment.concentration_risks",
              "assessment.capex_and_execution_risks",
              "assessment.agency_expectations",
              "assessment.upgrade_sensitivities",
              "assessment.downgrade_sensitivities",
              "assessment.material_conditions",
              "assessment.raw_material_and_forex_risk",
              "assessment.pricing_and_cost_pass_through",
              "assessment.order_book_and_execution",
              "assessment.payment_and_covenant_risk",
              "assessment.group_support"
            ]
          }
        },
        "statement": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "accounting_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualifications": {
          "type": "array"
        },
        "statement_kind": {
          "type": "string"
        },
        "evidence_decision": {
          "enum": [
            "SUPPORTED",
            "NEEDS_REVIEW",
            "WITHHELD"
          ]
        },
        "phase5_status": {
          "enum": [
            "VERIFIED",
            "EVIDENCED_STATEMENT",
            "AMBIGUOUS",
            "UNSUPPORTED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "validation": {
          "type": "object"
        },
        "origin": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "deterministic_extraction",
                "replayed_ai", "generated_ai",
                "live_ai"
              ]
            }
          }
        },
        "original_candidate": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_decision": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "fields": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_document_sha256",
        "region_id",
        "canonical_sha256",
        "page",
        "kind",
        "start",
        "end",
        "quote",
        "text_origin",
        "validation"
      ],
      "properties": {
        "source_document_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "region_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "page_text",
            "element_text",
            "table_cell"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "text_origin": {
          "enum": [
            "native",
            "ocr"
          ]
        },
        "validation": {
          "const": "EXACT_SOURCE_LOCATOR_VALIDATED"
        }
      }
    }
  }
}
