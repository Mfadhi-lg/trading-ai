{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "credit-rating-intelligence/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "certification",
    "claims",
    "groups",
    "coverage_ledger",
    "evidence_review_queue",
    "source_coverage",
    "provenance",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "credit-rating-intelligence/1.0.0"
    },
    "identity": {
      "type": "object",
      "required": [
        "company_id",
        "company_id_namespace",
        "company_name",
        "document_id",
        "content_sha256",
        "rating_agency",
        "report_date",
        "publication_date",
        "filing_date",
        "reporting_periods",
        "source_pdf",
        "field_states",
        "evidence"
      ],
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "company_id": {
          "type": "string"
        },
        "company_name": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "filing_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "reporting_periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_states": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "DISCLOSED",
              "NOT_DISCLOSED",
              "UNRESOLVED"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "certification": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "evidence_decision": {
                "const": "SUPPORTED"
              }
            }
          }
        ]
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "liquidity",
        "assessment"
      ],
      "properties": {
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "facility",
            "tenor",
            "current_rating",
            "previous_rating",
            "action",
            "outlook",
            "facility_amount",
            "watch",
            "withdrawal",
            "action_date"
          ],
          "properties": {
