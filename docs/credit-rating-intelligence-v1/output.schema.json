            },
            "action_date": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "liquidity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment",
            "cash_and_liquid_balances",
            "bank_limit_utilisation",
            "repayment_obligations",
            "cash_accruals",
            "explanations_and_constraints"
          ],
          "properties": {
            "assessment": {
              "$ref": "#/$defs/field"
            },
            "cash_and_liquid_balances": {
              "$ref": "#/$defs/field"
            },
            "bank_limit_utilisation": {
              "$ref": "#/$defs/field"
            },
            "repayment_obligations": {
              "$ref": "#/$defs/field"
            },
            "cash_accruals": {
              "$ref": "#/$defs/field"
            },
            "explanations_and_constraints": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accounting_approach",
            "revenue_and_profitability",
            "revenue_explanations",
            "profitability_explanations",
            "debt_and_leverage",
            "interest_coverage_and_debt_protection",
            "working_capital_intensity",
            "operational_strengths",
            "business_weaknesses",
            "concentration_risks",
            "capex_and_execution_risks",
            "agency_expectations",
            "upgrade_sensitivities",
            "downgrade_sensitivities",
            "material_conditions",
            "raw_material_and_forex_risk",
            "pricing_and_cost_pass_through",
            "order_book_and_execution",
            "payment_and_covenant_risk",
            "group_support"
          ],
          "properties": {
            "accounting_approach": {
              "$ref": "#/$defs/field"
            },
            "revenue_and_profitability": {
              "$ref": "#/$defs/field"
            },
            "revenue_explanations": {
              "$ref": "#/$defs/field"
            },
            "profitability_explanations": {
              "$ref": "#/$defs/field"
            },
            "debt_and_leverage": {
              "$ref": "#/$defs/field"
            },
            "interest_coverage_and_debt_protection": {
              "$ref": "#/$defs/field"
            },
            "working_capital_intensity": {
              "$ref": "#/$defs/field"
            },
            "operational_strengths": {
              "$ref": "#/$defs/field"
            },
            "business_weaknesses": {
              "$ref": "#/$defs/field"
            },
            "concentration_risks": {
              "$ref": "#/$defs/field"
            },
            "capex_and_execution_risks": {
              "$ref": "#/$defs/field"
            },
            "agency_expectations": {
              "$ref": "#/$defs/field"
            },
            "upgrade_sensitivities": {
              "$ref": "#/$defs/field"
            },
            "downgrade_sensitivities": {
              "$ref": "#/$defs/field"
            },
            "material_conditions": {
              "$ref": "#/$defs/field"
            },
            "raw_material_and_forex_risk": {
              "$ref": "#/$defs/field"
            },
            "pricing_and_cost_pass_through": {
              "$ref": "#/$defs/field"
            },
            "order_book_and_execution": {
              "$ref": "#/$defs/field"
            },
            "payment_and_covenant_risk": {
              "$ref": "#/$defs/field"
            },
            "group_support": {
              "$ref": "#/$defs/field"
            }
          }
        }
      }
    },
    "coverage_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating.facility",
        "rating.tenor",
        "rating.current_rating",
        "rating.previous_rating",
        "rating.action",
        "rating.outlook",
        "rating.facility_amount",
        "rating.watch",
        "rating.withdrawal",
        "rating.action_date",
        "liquidity.assessment",
        "liquidity.cash_and_liquid_balances",
        "liquidity.bank_limit_utilisation",
        "liquidity.repayment_obligations",
        "liquidity.cash_accruals",
        "liquidity.explanations_and_constraints",
        "assessment.accounting_approach",
        "assessment.revenue_and_profitability",
        "assessment.revenue_explanations",
        "assessment.profitability_explanations",
        "assessment.debt_and_leverage",
        "assessment.interest_coverage_and_debt_protection",
        "assessment.working_capital_intensity",
        "assessment.operational_strengths",
        "assessment.business_weaknesses",
        "assessment.concentration_risks",
        "assessment.capex_and_execution_risks",
        "assessment.agency_expectations",
        "assessment.upgrade_sensitivities",
        "assessment.downgrade_sensitivities",
        "assessment.material_conditions",
        "assessment.raw_material_and_forex_risk",
        "assessment.pricing_and_cost_pass_through",
        "assessment.order_book_and_execution",
        "assessment.payment_and_covenant_risk",
        "assessment.group_support"
      ],
      "properties": {
        "rating.facility": {
          "$ref": "#/$defs/field"
        },
        "rating.tenor": {
          "$ref": "#/$defs/field"
        },
        "rating.current_rating": {
          "$ref": "#/$defs/field"
        },
        "rating.previous_rating": {
          "$ref": "#/$defs/field"
        },
        "rating.action": {
          "$ref": "#/$defs/field"
        },
        "rating.outlook": {
          "$ref": "#/$defs/field"
        },
        "rating.facility_amount": {
          "$ref": "#/$defs/field"
        },
        "rating.watch": {
          "$ref": "#/$defs/field"
        },
        "rating.withdrawal": {
          "$ref": "#/$defs/field"
        },
        "rating.action_date": {
          "$ref": "#/$defs/field"
        },
        "liquidity.assessment": {
          "$ref": "#/$defs/field"
        },
        "liquidity.cash_and_liquid_balances": {
          "$ref": "#/$defs/field"
        },
        "liquidity.bank_limit_utilisation": {
