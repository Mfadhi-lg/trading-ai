{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable fresh candidate bundle; raw response can be malformed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "request_sha256",
    "raw_response_hex",
    "raw_response_sha256",
    "provider_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "credit-fresh/1"
    },
    "request": {
      "type": "object"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_response_hex": {
      "type": "string",
      "pattern": "^([a-f0-9]{2})*$"
    },
    "raw_response_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_receipt": {
      "type": "object"
    }
  }
}
