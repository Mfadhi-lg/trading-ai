# Safe example only. Supply credentials through a private libpq password file.
TRADING_AI_ENV=development
TRADING_AI_DB_BACKEND=postgresql
DATABASE_URL=postgresql://trading_ai_app@127.0.0.1:55432/trading_ai_dev
TRADING_AI_POSTGRESQL_SCHEMA=trading_ai
# Replace with the UUID returned by explicit setup, never invent a target ID.
TRADING_AI_POSTGRESQL_TARGET_ID=
PGPASSFILE=/absolute/path/to/private/pgpass
# Use an independently created temporary development root; never production.
SCRAPER_STORE_PATH=/absolute/path/to/development/store
SCRAPER_DB_PATH=/absolute/path/to/development/state/legacy-path-placeholder.db
