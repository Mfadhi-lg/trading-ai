  "services": {
    "artifact-reconciler": {
      "command": [
        "# Allow the scheduler to finish its bounded missed-day catch-up first.\nsleep 30\npython -m scrapper.cli backfill-result-artifacts\nwhile true; do\n  # 50 prioritized PPT/transcript expectations are normally 25\n  # company/result groups. This keeps\n  # the source-refresh batch comfortably inside the 15-minute leases.\n  python -m scrapper.cli reconcile-artifacts --due --limit 50\n  sleep 300\ndone\n"
      ],
      "configs": [
        {
          "source": "runtime_identity_core",
          "target": "/run/trading-ai/runtime-identity.json"
        },
        {
          "source": "runtime_store_sentinel",
          "target": "/data/.trading_ai_runtime_identity.json"
        },
        {
          "source": "runtime_core_documents_sentinel",
          "target": "/data/snapshots/.trading_ai_runtime_identity.json"
        }
      ],
      "cpus": 0.5,
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "environment": {
        "SCRAPER_DB_PATH": "/data/scraper.db",
        "SCRAPER_STORE_PATH": "/data",
        "SCREENER_SESSION_FILE": "/run/secrets/screener_session",
        "SCREENER_THROTTLE_JITTER": "1.5",
        "SCREENER_THROTTLE_SECONDS": "4",
        "TRADING_AI_ENV": "production",
        "TRADING_AI_RUNTIME_IDENTITY_FILE": "/run/trading-ai/runtime-identity.json"
      },
      "healthcheck": {
        "interval": "30s",
        "retries": 3,
        "test": [
          "CMD",
          "python",
          "-c",
          "import sqlite3; c=sqlite3.connect('file:/data/scraper.db?mode=ro',uri=True); c.execute('PRAGMA query_only=ON'); c.execute('SELECT 1'); c.close()"
        ],
        "timeout": "5s"
      },
      "image": "trading-ai-ar021-release@sha256:58060bbfeb8df338a3d3569c8f1489e0c1b784a1aa584f3b23a890e5dc5fe1ae",
      "mem_limit": "1610612736",
      "networks": {
        "default": null
      },
      "profiles": [
        "authorized-artifact-reconciler"
      ],
      "restart": "no",
      "secrets": [
        {
          "source": "screener_session",
          "target": "/run/secrets/screener_session"
        }
      ],
      "stop_grace_period": "3m0s",
      "volumes": [
        {
          "source": "scraper-data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
