  {
    "role": "rating-recovery-discovery",
    "entrypoint": [
      "/bin/sh",
      "-c"
    ],
    "command": [
      "python -m scrapper.cli build-document-recovery-targets\nwhile true; do\n  out=$$(python -m scrapper.cli run-document-recovery-worker \\\n    --source bse --source nse --source issuer-ir \\\n    --limit 50 --throttle-seconds 2)\n  echo \"$$out\"\n  case \"$$out\" in\n    *'\"processed_target_source_count\": 0'*) sleep 120 ;;\n    *) sleep 3 ;;\n  esac\ndone\n"
    ],
    "environment": {
      "DOCUMENT_MIN_FREE_BYTES": "107374182400",
      "DOCUMENT_MIN_FREE_PERCENT": "15",
      "DOCUMENT_REQUIRE_SENTINEL": "1",
