[
  {
    "role": "artifact-reconciler",
    "entrypoint": [
      "/bin/sh",
      "-c"
    ],
    "command": [
      "# Allow the scheduler to finish its bounded missed-day catch-up first.\nsleep 30\npython -m scrapper.cli backfill-result-artifacts\nwhile true; do\n  # 50 prioritized PPT/transcript expectations are normally 25\n  # company/result groups. This keeps\n  # the source-refresh batch comfortably inside the 15-minute leases.\n  python -m scrapper.cli reconcile-artifacts --due --limit 50\n  sleep 300\ndone\n"
    ],
    "environment": {
      "SCRAPER_DB_PATH": "/data/scraper.db",
      "SCRAPER_STORE_PATH": "/data",
      "SCREENER_SESSION_FILE": "/run/secrets/screener_session",
      "SCREENER_THROTTLE_JITTER": "1.5",
      "SCREENER_THROTTLE_SECONDS": "4",
      "TRADING_AI_ENV": "production",
      "TRADING_AI_RUNTIME_IDENTITY_FILE": "/run/trading-ai/runtime-identity.json"
    },
    "profiles": [
      "authorized-artifact-reconciler"
    ],
    "restart": "no",
    "image": "trading-ai-c281-release@sha256:4d289faa67334bc870d4f2a6a181feecee777fd427eac209b9adef68ecab0238"
  },
